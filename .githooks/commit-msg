#!/bin/sh
# 커밋 작성자와 메시지에 이 저장소 소유자 말고 다른 이름이 붙는 것을 막는다.
#
# 왜 필요한가: AI 코딩 도구는 컨테이너 전역 git 설정과 자동 트레일러로
# 자기 이름을 붙인다. Co-Authored-By 는 GitHub 이 contributor 를 세는 기준이라
# 한 줄만 새어 나가도 저장소 기여자 목록에 이름이 올라간다. 커밋을 만드는
# 쪽이 무엇이든 여기서 걸린다.

message_file="$1"

if grep -qiE '^[[:space:]]*Co-Authored-By[[:space:]]*:' "$message_file"; then
	echo >&2 "커밋 거부: Co-Authored-By 트레일러를 지워 주세요."
	exit 1
fi

if grep -qiE '^[[:space:]]*(Codex-Session|Claude-Session|Generated-By|AI-Assisted)[[:space:]]*:|^[[:space:]]*[A-Za-z0-9-]+[[:space:]]*:.*(claude|anthropic|copilot|cursor|codex|openai)' "$message_file"; then
	echo >&2 "커밋 거부: AI 도구 트레일러가 들어 있다."
	echo >&2 "  해당 줄을 지우고 다시 커밋해라."
	exit 1
fi

author_name=$(git var GIT_AUTHOR_IDENT | sed 's/ <.*//')
author_email=$(git var GIT_AUTHOR_IDENT | sed 's/.*<//; s/>.*//')

if [ "$author_name" != 'easygap' ] ||
   [ "$author_email" != '103491329+easygap@users.noreply.github.com' ]; then
	echo >&2 "커밋 거부: 작성자는 easygap 계정이어야 합니다."
	echo >&2 "  git config user.name easygap"
	echo >&2 "  git config user.email 103491329+easygap@users.noreply.github.com"
	exit 1
fi

exit 0
