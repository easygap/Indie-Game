msgid "5층 철문 닫히는 소리"
msgstr "五楼铁门关上的声音"

#. Key:	NoSignalCaption
#. SourceLocation:	Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(4554)
#: Source/IndieGame/Entity/IGListenerGreyboxDirector.cpp(4554)
