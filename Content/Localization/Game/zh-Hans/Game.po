msgid "[같은 건반을 다시 누른다. 이번엔 음이 맞는다]"
msgstr "［再按一次同一个琴键。这次音准了］"

#. Key:	EpilogueAutumnHeading
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(575)
#: Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(575)
