msgid "가을, 무영로"
msgstr "秋天，无影路"

#. Key:	EpilogueAutumnFootnote
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(580)
#: Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(580)
msgctxt "IGMissingFloor,EpilogueAutumnFootnote"
msgid "네 시 반 알람은 지웠다."
msgstr "凌晨四点半的闹钟删掉了。"

#. Key:	EpilogueNewsHeading
#. SourceLocation:	Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(589)
#: Source/IndieGame/Entity/IGMissingFloorEpilogueDirector.cpp(589)
